# Credentials. Copy to .env, which is git-ignored. Never commit this filled in.
# Every value here is read by name from config; no config file contains a secret.

# ── Required ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── What the system calls itself ────────────────────────────────────
# All four have neutral defaults and are safe to leave blank.
BRAND_LABEL=
AGENT_COMMIT_NAME=
AGENT_COMMIT_EMAIL=
BRAND_ID=

# Addresses the outbound sender must never contact, comma separated.
NEVER_MAIL=

# ── Publishing, each independently optional ─────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

LINKEDIN_ACCESS_TOKEN=

# Only for publisher: webhook
BLOG_WEBHOOK_URL=
BLOG_WEBHOOK_SECRET=

# ── Measurement, optional ───────────────────────────────────────────
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GSC_SITE_URL=

# ── Notifications, optional but strongly recommended ────────────────
BREVO_API_KEY=
SENDER_NAME=
SENDER_EMAIL=

# ── Media, optional ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
LOGO_URL=

# ── Where the board is written, optional ────────────────────────────
DASHBOARD_OUT=
